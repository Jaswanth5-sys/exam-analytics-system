# Node dependencies
node_modules/
.pnp
.pnp.js

# Production build outputs
dist/
build/
out/
*.tsbuildinfo

# Environment variables and secrets (Strictly ignore all secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.env
*.env.*

# Keep example configuration templates tracked in Git
!.env.example
!server/.env.example
!client/.env.example

# Runtime and application logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test and code coverage
coverage/
.nyc_output/

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Editor and IDE configurations
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
