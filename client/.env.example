# ==============================================================================
# Online Quiz & Examination Analytics System - Frontend Environment Configuration
# ==============================================================================

# API Base URL for backend requests
# Default in development: /api (proxied automatically by Vite dev server to backend)
# In standalone production deployment: http://your-backend-host:5000/api or https://api.yourdomain.com/api
VITE_API_URL=/api

# Backend server address for Vite development proxy (optional, defaults to http://localhost:5000)
VITE_BACKEND_URL=http://localhost:5000
