# ==============================================================================
# Online Quiz & Examination Analytics System - Backend Environment Configuration
# ==============================================================================

# Server Network Settings
PORT=5000
NODE_ENV=production

# JSON Web Token (JWT) Security
# IMPORTANT: Generate a strong, random 32+ character secret for production
JWT_SECRET=replace_with_a_secure_random_32_char_secret_in_production
JWT_EXPIRES_IN=7d

# MonetDB Connection Settings
# Port 50000 is the standard MonetDB MAPI port
MONETDB_HOST=127.0.0.1
MONETDB_PORT=50000
MONETDB_DATABASE=demo
MONETDB_USER=monetdb
MONETDB_PASSWORD=your_monetdb_password_here

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed frontend origins (or * in development)
CORS_ORIGIN=http://localhost:3000
