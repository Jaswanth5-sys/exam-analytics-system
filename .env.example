# ==============================================================================
# Online Quiz & Examination Analytics System - Master Environment Configuration
# ==============================================================================
# Copy this file to server/.env and client/.env (or set variables in your deployment environment).

# ------------------------------------------------------------------------------
# Backend Configuration (server/.env)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# JWT Signing Secret (replace with random 32+ characters in production)
JWT_SECRET=replace_with_a_secure_random_32_char_secret_in_production
JWT_EXPIRES_IN=7d

# MonetDB Database Connection (Port 50000 is default MonetDB MAPI port)
MONETDB_HOST=127.0.0.1
MONETDB_PORT=50000
MONETDB_DATABASE=demo
MONETDB_USER=monetdb
MONETDB_PASSWORD=your_monetdb_password_here

# Allowed CORS Origins (comma-separated if multiple)
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# Frontend Configuration (client/.env)
# ------------------------------------------------------------------------------
# In local development: /api (proxied via Vite)
# In production: http://your-backend-host:5000/api or https://api.yourdomain.com/api
VITE_API_URL=/api
VITE_BACKEND_URL=http://localhost:5000
